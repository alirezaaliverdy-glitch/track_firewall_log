{
	admin off
}

{$PUBLIC_HOST:eosnet.ir} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@api path_regexp api ^/firewall-api(/.*)$
	handle @api {
		rewrite * /api{re.api.1}
		reverse_proxy firewall-api:4000 {
			header_up -Origin
		}
	}

	handle {
		reverse_proxy firewall-web:50
	}
}
