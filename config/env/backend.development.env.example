NODE_ENV=development
APP_PROFILE=lab
PRODUCT_MODE=persian_command_catalog
PORT=4000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://firewall_app:replace-with-db-password@127.0.0.1:5432/firewall_log_analyzer
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=25

AI_PROVIDER=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=openrouter/free

CREDENTIAL_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

ACTION_EXECUTION_MODE=quick_controlled
ACTION_REQUIRE_MANAGEMENT_SOURCE=false
ACTION_DEFAULT_TRUSTED_SOURCE=auto
ACTION_ALLOW_LAB_UNRESTRICTED_MANAGEMENT=true

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-development-admin-password
ADMIN_DISPLAY_NAME=Administrator
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_TTL_HOURS=12

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_APP_URL=http://localhost/firewall
SECURITY_MONITORING_ENABLED=true
SECURITY_MONITOR_TICK_SECONDS=5
SECURITY_COLLECTOR_INTERVAL_SECONDS=60
