NODE_ENV=development
APP_PROFILE=staging
PRODUCT_MODE=persian_command_catalog
PORT=4000
CORS_ORIGIN=https://staging.example.invalid
DATABASE_URL=postgresql://firewall_app:replace-with-staging-db-password@firewall-db:5432/firewall_log_analyzer_staging
UPLOAD_DIR=/app/storage/uploads
MAX_UPLOAD_MB=25

AI_PROVIDER=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=openrouter/free

CREDENTIAL_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

ACTION_EXECUTION_MODE=direct_controlled
ACTION_REQUIRE_MANAGEMENT_SOURCE=true
ACTION_DEFAULT_TRUSTED_SOURCE=auto
ACTION_ALLOW_LAB_UNRESTRICTED_MANAGEMENT=false

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-staging-admin-password
ADMIN_DISPLAY_NAME=Administrator
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_TTL_HOURS=12

# Continuous read-only vendor log monitoring and detection.
SECURITY_MONITORING_ENABLED=true
SECURITY_MONITOR_TICK_SECONDS=5
SECURITY_COLLECTOR_INTERVAL_SECONDS=60
