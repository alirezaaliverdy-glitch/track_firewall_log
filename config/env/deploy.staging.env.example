# Deployment variables consumed by docker-compose.staging.yml.
# Use an immutable tag, normally the Git commit SHA built by the staging workflow.
DEPLOY_VERSION=replace-with-git-sha
FRONTEND_IMAGE=ghcr.io/owner/repository/frontend:replace-with-git-sha
BACKEND_IMAGE=ghcr.io/owner/repository/backend:replace-with-git-sha
FIREWALL_HTTP_PORT=8080
