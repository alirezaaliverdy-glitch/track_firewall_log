[Unit]
Description=EOSNET scoped disposable storage maintenance
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=alireza
WorkingDirectory=/home/alireza/track_firewall_log
ExecStart=/bin/sh scripts/deploy/maintain-production-storage.sh --apply
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
TimeoutStartSec=300
