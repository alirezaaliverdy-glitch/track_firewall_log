{
  "name": "firewall-log-analyzer-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "audit:device-assets": "tsx src/scripts/reconcile-device-assets.ts",
    "repair:device-assets": "tsx src/scripts/reconcile-device-assets.ts --apply",
    "test:r-e": "tsx --test test/task19-1-action-center-ux.test.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test:smoke": "node scripts/smoke-api.mjs",
    "validate:env": "tsx src/scripts/validate-env.ts",
    "test": "tsx src/scripts/run-all-tests.ts",
    "validate:command-catalog": "tsx src/commands/catalog/validate-command-catalog.ts",
    "lint": "eslint src --ext .ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.0.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.1",
    "pg": "^8.22.0",
    "prisma": "7.10.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.0",
    "@types/pg": "^8.20.0",
    "@types/ssh2": "^1.15.5",
    "eslint": "^9.36.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0"
  },
  "pnpm": {
    "overrides": {
      "@fastify/ajv-compiler>fast-uri": "3.1.5",
      "@prisma/config>deepmerge-ts": "8.0.0",
      "@visx/responsive>lodash": "4.18.0",
      "@visx/shape>lodash": "4.18.0",
      "ajv>fast-uri": "3.1.5",
      "fast-json-stringify>fast-uri": "3.1.5",
      "fastify>find-my-way": "9.7.0"
    }
  }
}
