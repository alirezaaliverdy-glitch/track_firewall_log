generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Upload {
  id                      String        @id @default(cuid())
  fileName                String
  originalFileName        String
  fileSize                Int
  mimeType                String?
  fileExtension           String
  detectedFormat          String?
  selectedVendor          String?
  detectedVendor          String?
  status                  UploadStatus
  rowCount                Int?
  parseWarningCount       Int?
  checksum                String?
  storagePath             String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  jobs                    Job[]
  analysisRuns            AnalysisRun[]
}

model Job {
  id            String    @id @default(cuid())
  uploadId      String
  upload        Upload    @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  type          JobType
  status        JobStatus
  progress      Int       @default(0)
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([uploadId])
}

model AnalysisRun {
  id                      String         @id @default(cuid())
  uploadId                String
  upload                  Upload         @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  status                  AnalysisStatus
  resultJson              Json?
  summaryJson             Json?
  logProfileJson          Json?
  trafficIntelligenceJson Json?
  sensitivePortsJson      Json?
  policyReviewJson        Json?
  findingsJson            Json?
  normalizedLogsJson      Json?
  parseWarningsJson       Json?
  rowCount                Int?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([uploadId])
}

model Device {
  id                String              @id @default(cuid())
  name              String
  vendor            String
  type              DeviceType
  host              String
  managementPort    Int
  protocol          DeviceProtocol
  credentialId      String?
  credential        DeviceCredential?  @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  credentialRef     String?
  environment       DeviceEnvironment
  tags              String[]            @default([])
  status            DeviceStatus        @default(unknown)
  capabilities      Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  authProfiles      DeviceAuthProfile[]
  deviceCapabilities DeviceCapability[]
  statusChecks      DeviceStatusCheck[]
  auditLogs         AuditLog[]
  eventSources      EventSource[]
  eventBatches      EventBatch[]
  securityEvents    SecurityEvent[]
  incidents         Incident[]
  aiActionIntents   AiActionIntent[]
  actionPlans       ActionPlan[]
  actionAuditLogs   ActionAuditLog[]

  @@index([type])
  @@index([host])
  @@index([credentialId])
  @@index([credentialRef])
  @@index([status])
}

model DeviceCredential {
  id                    String               @id @default(cuid())
  name                  String               @unique
  type                  DeviceCredentialType
  username              String
  secretEncrypted       String
  privateKeyEncrypted   String?
  passphraseEncrypted   String?
  sudo                  Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  devices               Device[]

  @@index([type])
  @@index([name])
}

model AiChatSession {
  id        String          @id @default(cuid())
  title     String
  userId    String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  AiChatMessage[]
  intents   AiActionIntent[]

  @@index([userId])
  @@index([createdAt])
}

model AiChatMessage {
  id             String          @id @default(cuid())
  sessionId      String
  session        AiChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role           AiChatRole
  content        String
  structuredJson Json?
  createdAt      DateTime        @default(now())
  actionIntents  AiActionIntent[]

  @@index([sessionId])
  @@index([role])
  @@index([createdAt])
}

model AiActionIntent {
  id             String               @id @default(cuid())
  sessionId      String
  session        AiChatSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messageId      String?
  message        AiChatMessage?       @relation(fields: [messageId], references: [id], onDelete: SetNull)
  deviceId       String?
  device         Device?              @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  intentType     AiIntentType
  status         AiActionIntentStatus @default(proposed)
  riskLevel      AiRiskLevel
  parametersJson Json
  explanation    String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  actionPlans    ActionPlan[]

  @@index([sessionId])
  @@index([messageId])
  @@index([deviceId])
  @@index([intentType])
  @@index([status])
  @@index([riskLevel])
  @@index([createdAt])
}

model ActionPlan {
  id             String             @id @default(cuid())
  source         ActionPlanSource
  requestedBy    String?
  deviceId       String?
  device         Device?            @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  aiIntentId     String?
  aiIntent       AiActionIntent?    @relation(fields: [aiIntentId], references: [id], onDelete: SetNull)
  actionType     ActionType
  status         ActionPlanStatus   @default(proposed)
  riskLevel      AiRiskLevel
  parametersJson Json
  validationJson Json?
  dryRunJson     Json?
  approvalJson   Json?
  resultJson     Json?
  rollbackJson   Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  auditLogs      ActionAuditLog[]
  approvals      ActionApproval[]

  @@index([source])
  @@index([deviceId])
  @@index([aiIntentId])
  @@index([actionType])
  @@index([status])
  @@index([riskLevel])
  @@index([createdAt])
}

model ActionAuditLog {
  id             String     @id @default(cuid())
  actionPlanId   String
  actionPlan     ActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  deviceId       String?
  device         Device?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  eventType      String
  message        String
  metadataJson   Json?
  createdAt      DateTime   @default(now())

  @@index([actionPlanId])
  @@index([deviceId])
  @@index([eventType])
  @@index([createdAt])
}

model ActionApproval {
  id             String           @id @default(cuid())
  actionPlanId   String
  actionPlan     ActionPlan       @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  approvedBy     String?
  decision       ApprovalDecision
  reason         String?
  createdAt      DateTime         @default(now())

  @@index([actionPlanId])
  @@index([decision])
  @@index([createdAt])
}

model EventSource {
  id             String             @id @default(cuid())
  name           String
  type           EventSourceType
  deviceId       String?
  device         Device?            @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  status         EventSourceStatus  @default(active)
  lastSeenAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  batches        EventBatch[]
  securityEvents SecurityEvent[]
  incidents      Incident[]

  @@index([type])
  @@index([deviceId])
  @@index([status])
  @@index([lastSeenAt])
}

model EventBatch {
  id             String           @id @default(cuid())
  sourceId       String?
  source         EventSource?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  deviceId       String?
  device         Device?          @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  status         EventBatchStatus
  totalEvents    Int              @default(0)
  parsedEvents   Int              @default(0)
  failedEvents   Int              @default(0)
  createdAt      DateTime         @default(now())
  completedAt    DateTime?
  securityEvents SecurityEvent[]

  @@index([sourceId])
  @@index([deviceId])
  @@index([status])
  @@index([createdAt])
}

model SecurityEvent {
  id             String       @id @default(cuid())
  deviceId       String?
  device         Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  sourceId       String?
  source         EventSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  batchId        String?
  batch          EventBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  timestamp      DateTime?
  receivedAt     DateTime     @default(now())
  vendor         String?
  eventType      String
  action         String?
  severity       String?
  srcIp          String?
  srcPort        Int?
  dstIp          String?
  dstPort        Int?
  protocol       String?
  username       String?
  ruleName       String?
  interfaceIn    String?
  interfaceOut   String?
  rawMessage     String?
  normalizedJson Json
  tags           Json?
  createdAt      DateTime     @default(now())
  incidentEvents IncidentEvent[]

  @@index([deviceId])
  @@index([sourceId])
  @@index([batchId])
  @@index([timestamp])
  @@index([receivedAt])
  @@index([vendor])
  @@index([action])
  @@index([severity])
  @@index([srcIp])
  @@index([dstIp])
  @@index([dstPort])
  @@index([protocol])
}

model DetectionRule {
  id            String            @id @default(cuid())
  name          String
  description   String
  enabled       Boolean           @default(true)
  severity      IncidentSeverity
  ruleType      DetectionRuleType
  queryJson     Json?
  thresholdJson Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  incidents     Incident[]

  @@index([enabled])
  @@index([ruleType])
  @@unique([ruleType, name])
}

model Incident {
  id          String             @id @default(cuid())
  title       String
  description String
  severity    IncidentSeverity
  status      IncidentStatus     @default(open)
  deviceId    String?
  device      Device?            @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  sourceId    String?
  source      EventSource?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  ruleId      String?
  rule        DetectionRule?      @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  firstSeenAt DateTime
  lastSeenAt  DateTime
  eventCount  Int                @default(0)
  summaryJson Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  events      IncidentEvent[]

  @@index([status])
  @@index([severity])
  @@index([deviceId])
  @@index([sourceId])
  @@index([ruleId])
  @@index([firstSeenAt])
  @@index([lastSeenAt])
}

model IncidentEvent {
  id              String        @id @default(cuid())
  incidentId      String
  incident        Incident      @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  securityEventId String
  securityEvent   SecurityEvent @relation(fields: [securityEventId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@index([incidentId])
  @@index([securityEventId])
  @@unique([incidentId, securityEventId])
}

model DeviceAuthProfile {
  id               String   @id @default(cuid())
  deviceId         String
  device           Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name             String
  credentialRef    String
  authType         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([deviceId])
}

model DeviceCapability {
  id                     String   @id @default(cuid())
  deviceId               String
  device                 Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name                   String
  category               String
  enabled                Boolean  @default(false)
  dryRunSupported        Boolean  @default(true)
  manualApprovalRequired Boolean  @default(true)
  metadata               Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([deviceId])
}

model DeviceStatusCheck {
  id          String       @id @default(cuid())
  deviceId    String
  device      Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  status      DeviceStatus
  message     String?
  latencyMs   Int?
  checkedAt   DateTime     @default(now())

  @@index([deviceId])
  @@index([checkedAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  deviceId       String?
  device         Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  actor          String?
  action         String
  targetType     String
  targetId       String?
  dryRun         Boolean  @default(true)
  approvalStatus String   @default("not_required")
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([deviceId])
  @@index([action])
  @@index([createdAt])
}

enum UploadStatus {
  uploaded
  queued
  processing
  analyzed
  failed
  deleted
}

enum JobStatus {
  queued
  processing
  completed
  failed
}

enum JobType {
  import
  analyze
  ai_report
}

enum AnalysisStatus {
  pending
  completed
  failed
}

enum DeviceType {
  linux_edge
  mikrotik
  fortigate
  pfsense
  generic_syslog_source
  generic_firewall
}

enum DeviceProtocol {
  ssh
  api
  syslog
  agent
}

enum DeviceEnvironment {
  production
  staging
  lab
}

enum DeviceStatus {
  unknown
  online
  offline
  error
}

enum DeviceCredentialType {
  password
  private_key
}

enum EventSourceType {
  upload
  syslog
  agent
  api
  manual
}

enum EventSourceStatus {
  active
  inactive
  error
}

enum EventBatchStatus {
  processing
  completed
  failed
  partial
}

enum IncidentSeverity {
  low
  medium
  high
  critical
}

enum IncidentStatus {
  open
  investigating
  resolved
  false_positive
}

enum DetectionRuleType {
  port_scan
  ssh_bruteforce
  sensitive_port_exposure
  deny_drop_spike
  suspicious_outbound
}

enum AiChatRole {
  user
  assistant
  system
  tool
}

enum AiActionIntentStatus {
  proposed
  discarded
  converted_to_action_plan
}

enum AiRiskLevel {
  low
  medium
  high
  critical
}

enum AiIntentType {
  create_egress_policy
  update_policy_schedule
  block_source_ip_temporary
  unblock_source_ip
  open_port
  close_port
  change_ssh_port
  create_address_object
  create_schedule_object
  create_service_object
  add_firewall_rule
  remove_firewall_rule
  enable_rule
  disable_rule
  explain_security_status
  unknown
}

enum ActionPlanSource {
  ai
  user
  system
  detection
}

enum ActionPlanStatus {
  proposed
  validation_failed
  dry_run_ready
  awaiting_approval
  approved
  rejected
  executing
  succeeded
  failed
  rolled_back
}

enum ActionType {
  create_egress_policy
  update_policy_schedule
  block_source_ip_temporary
  unblock_source_ip
  open_port
  close_port
  change_ssh_port
  create_address_object
  create_schedule_object
  create_service_object
  add_firewall_rule
  remove_firewall_rule
  enable_rule
  disable_rule
}

enum ApprovalDecision {
  approved
  rejected
}
