NODE_ENV=development
APP_PROFILE=lab
PRODUCT_MODE=persian_command_catalog
PORT=4000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://firewall_app:replace-with-db-password@localhost:5432/firewall_log_analyzer
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=25

AI_PROVIDER=mock
# For the default openrouter/free model use AI_PROVIDER=openai_compatible.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=openrouter/free
# Optional host proxy used by Docker Desktop when direct OpenRouter traffic is blocked.
OPENAI_PROXY_URL=
OPENAI_FALLBACK_MODELS=nvidia/nemotron-3-super:free,openai/gpt-oss-20b:free,google/gemma-4-31b-it:free
AI_TIMEOUT_MS=30000
AI_MAX_CONTEXT_EVENTS=50
AI_MAX_CONTEXT_INCIDENTS=20
AI_MAX_CONTEXT_FINDINGS=20
AI_MAX_ACTION_PLANS=15
AI_MAX_EVIDENCE_LINES=30
AI_MAX_RAW_MESSAGE_CHARS=300
AI_INCLUDE_RAW_LOGS=false

CREDENTIAL_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

EVENT_RETENTION_LOW_DAYS=7
EVENT_RETENTION_MEDIUM_DAYS=30
EVENT_RETENTION_HIGH_DAYS=90
EVENT_RETENTION_CRITICAL_DAYS=180
EVENT_MAX_ROWS=200000
EVENT_MAX_RAW_SNIPPET_CHARS=2000
EVENT_DEDUP_WINDOW_MINUTES=60
EVENT_RETENTION_RUN_INTERVAL_MINUTES=60

SSH_CONNECT_TIMEOUT_MS=15000
SSH_HANDSHAKE_TIMEOUT_MS=15000
SSH_COMMAND_TIMEOUT_MS=10000

ACTION_EXECUTION_MODE=quick_controlled
ACTION_REQUIRE_MANAGEMENT_SOURCE=false
ACTION_DEFAULT_TRUSTED_SOURCE=auto
ACTION_ALLOW_LAB_UNRESTRICTED_MANAGEMENT=true

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-admin-password
ADMIN_DISPLAY_NAME=Administrator
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_TTL_HOURS=12

# SMTP is configured only on the server. Alert recipients are managed in the UI.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_APP_URL=http://localhost/firewall
SECURITY_MONITORING_ENABLED=true
SECURITY_MONITOR_TICK_SECONDS=5
SECURITY_COLLECTOR_INTERVAL_SECONDS=60
