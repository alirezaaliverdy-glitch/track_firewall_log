PORT=4000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/firewall_log_analyzer
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=25
AI_PROVIDER=openai_compatible
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=openrouter/free
OPENAI_FALLBACK_MODELS=nvidia/nemotron-3-super:free,openai/gpt-oss-20b:free,google/gemma-4-31b-it:free
SSH_CREDENTIALS_JSON={"ubuntu-lab-root":{"username":"root","password":"PASSWORD"},"ubuntu-lab-key":{"username":"alireza","privateKeyPath":"C:/Users/Surfaceland/.ssh/id_rsa","sudo":true}}
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-secret-for-local-dev
EVENT_RETENTION_LOW_DAYS=7
EVENT_RETENTION_MEDIUM_DAYS=30
EVENT_RETENTION_HIGH_DAYS=90
EVENT_RETENTION_CRITICAL_DAYS=180
EVENT_MAX_ROWS=200000
EVENT_MAX_RAW_SNIPPET_CHARS=2000
EVENT_DEDUP_WINDOW_MINUTES=60
EVENT_RETENTION_RUN_INTERVAL_MINUTES=60
SSH_CONNECT_TIMEOUT_MS=15000
SSH_HANDSHAKE_TIMEOUT_MS=15000
SSH_COMMAND_TIMEOUT_MS=10000
ACTION_EXECUTION_MODE=quick_controlled
ACTION_REQUIRE_MANAGEMENT_SOURCE=false
ACTION_DEFAULT_TRUSTED_SOURCE=auto
ACTION_ALLOW_LAB_UNRESTRICTED_MANAGEMENT=true

# direct_controlled: one-click execution for validated catalog actions
# lab_fast: approval record without typed APPROVE for non-critical actions
# safe: typed confirmation for high-risk actions and break-glass for critical actions
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
ADMIN_DISPLAY_NAME=Alireza
AUTH_SESSION_SECRET=replace-with-long-random-secret
AUTH_SESSION_TTL_HOURS=12
